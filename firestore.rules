rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isFamily() {
      return request.auth != null
        && request.auth.token.email in [
          "hafuxu1227@gmail.com",
          "YOUR_GOOGLE_EMAIL_2"
        ];
    }

    match /shoppingLists/family/items/{itemId} {
      allow read, delete: if isFamily();
      allow create: if isFamily()
        && request.resource.data.keys().hasOnly([
          "name", "createdAt", "createdBy", "createdByName"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
    }

    match /shoppingLists/family/completed/{itemId} {
      allow read, delete: if isFamily();
      allow create: if isFamily()
        && request.resource.data.keys().hasOnly([
          "name", "createdAt", "createdBy", "createdByName",
          "completedAt", "completedBy", "completedByName"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.completedBy == request.auth.uid;
      allow update: if false;
    }
  }
}
