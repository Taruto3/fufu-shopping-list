{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      ".git",
      ".git/**",
      "node_modules",
      "node_modules/**",
      "**/node_modules/**",
      "README.md",
      "SETUP.md",
      "firestore.rules",
      "package.json"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.@(js|css|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
